# Server-only PostgreSQL connection. Do not use a NEXT_PUBLIC_ prefix.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:25060/defaultdb?sslmode=require
# Optional: DigitalOcean cluster CA certificate, with newlines represented as \n.
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Server-only admin login. Both are required; never use a NEXT_PUBLIC_ prefix.
ADMIN_USER=
ADMIN_PASSWORD=
